@model IEnumerable<NZWalksWebApp.Models.DTO.RegionsDto>

<h4>API Response Page</h4>
<div class="table mt-4">
	<div class="d-flex justify-content-end my-1">
		<a class="btn btn-primary" asp-controller="Regions" asp-action="AddRegion"> Add a Region</a>
	</div>
	<table class="table border">
		<thead>
			<tr>
				<th>Region Id</th>
				<th>Name</th>
				<th>Code</th>
				<th>ImageUrl</th>
				<th>Action</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var regionDto in Model)
			{
				<tr>
					<td>@regionDto.Id</td>
					<td>@regionDto.Name</td>
					<td>@regionDto.Code</td>
					<td>@regionDto.RegionImageUrl</td>
					<td class="d-flex justify-content-between">
						<a class="btnEditData btn btn-outline-secondary mx-1" asp-controller="Regions" asp-action="EditRegion" asp-route-id="@regionDto.Id">Edit</a>
						<button type="button" class="btnDeleteData btn btn-outline-danger" data-Id="@regionDto.Id" data-row-id="row-@regionDto.Id">Delete</button>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>




