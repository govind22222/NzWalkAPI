
<div class="container">
	<h3 class="my-3"> Add Region</h3>
	<form class="" id="frmAddRegion" method="post">

		<div class="mt-2">
			<label class="form-label">Region Code</label>
			<input type="text" class="form-control" id="txtCode" />
		</div>
		<div class="mt-2">
			<label class="form-label">Name</label>
			<input type="text" class="form-control" id="txtName" />
		</div>
		<div class="mt-2">
			<label class="form-label">Image Url</label>
			<input type="text" class="form-control" id="txtUrl" />
		</div>
		<div class="mt-2">
			<button type="submit" class="btn btn-primary" id="btnAddRegion">Save</button>
		</div>
	</form>
</div>
